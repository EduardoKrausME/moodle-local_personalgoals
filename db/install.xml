<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/personalgoals/db" VERSION="20261003" COMMENT="XMLDB file for local_personalgoals"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="local_personalgoals_goals" COMMENT="Personal goals created or accepted by learners">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="goaltype" TYPE="char" LENGTH="100" NOTNULL="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="targetvalue" TYPE="number" LENGTH="20" DECIMALS="5" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="configjson" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timestart" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timeend" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="active"/>
        <FIELD NAME="completedat" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userfk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="coursefk" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="usercourse" UNIQUE="false" FIELDS="userid,courseid"/>
        <INDEX NAME="statusend" UNIQUE="false" FIELDS="status,timeend"/>
        <INDEX NAME="userstatus" UNIQUE="false" FIELDS="userid,status"/>
        <INDEX NAME="coursetype" UNIQUE="false" FIELDS="courseid,goaltype"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_personalgoals_progress" COMMENT="Cached incremental progress for personal goals">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="goalid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="currentvalue" TYPE="number" LENGTH="20" DECIMALS="5" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="datajson" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="goalfk" TYPE="foreign-unique" FIELDS="goalid" REFTABLE="local_personalgoals_goals" REFFIELDS="id"/>
      </KEYS>
    </TABLE>

    <TABLE NAME="local_personalgoals_template" COMMENT="Teacher suggested goal templates">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="goaltype" TYPE="char" LENGTH="100" NOTNULL="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="targetvalue" TYPE="number" LENGTH="20" DECIMALS="5" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="periodtype" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="none"/>
        <FIELD NAME="configjson" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="active" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="coursefk" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseactive" UNIQUE="false" FIELDS="courseid,active"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_personalgoals_limits" COMMENT="Per-course limits for learner-created goals">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="goaltype" TYPE="char" LENGTH="100" NOTNULL="true"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="mintarget" TYPE="number" LENGTH="20" DECIMALS="5" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="maxtarget" TYPE="number" LENGTH="20" DECIMALS="5" NOTNULL="true" DEFAULT="1000000"/>
        <FIELD NAME="maxactive" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="10"/>
        <FIELD NAME="allowcustomdates" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="maxdurationdays" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="365"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="coursefk" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="coursetypeuniq" UNIQUE="true" FIELDS="courseid,goaltype"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_personalgoals_days" COMMENT="Distinct active study days per learner and course">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="daykey" TYPE="char" LENGTH="8" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userfk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="coursefk" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="usercoursedayuniq" UNIQUE="true" FIELDS="userid,courseid,daykey"/>
        <INDEX NAME="usercourse" UNIQUE="false" FIELDS="userid,courseid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_personalgoals_sessions" COMMENT="Last meaningful learner interaction used for study-time goals">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="lastactivity" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userfk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="coursefk" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="usercourseuniq" UNIQUE="true" FIELDS="userid,courseid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_personalgoals_eventlog" COMMENT="Hash-only deduplication of processed Moodle events">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="eventkey" TYPE="char" LENGTH="64" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="eventkeyuniq" UNIQUE="true" FIELDS="eventkey"/>
        <INDEX NAME="timecreated" UNIQUE="false" FIELDS="timecreated"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
