{{!
    @template local_personalgoals/history

    Example context (json):
    {
        *Example context (json):*
    }
}}
<div class="local-personalgoals personalgoals-history">
    <div class="personalgoals-toolbar">
        <div>
            <h2>{{#str}}goalhistory, local_personalgoals{{/str}}</h2>
            <p class="text-muted mb-0">{{#str}}historyintro, local_personalgoals{{/str}}</p>
        </div>
        <a class="btn btn-secondary" href="{{{backurl}}}">{{#str}}backtogoals, local_personalgoals{{/str}}</a>
    </div>

    {{#hasmonths}}
    <section class="personalgoals-section">
        <h3>{{#str}}monthlyevolution, local_personalgoals{{/str}}</h3>
        <div class="personalgoals-months">
            {{#months}}
                <div class="personalgoals-month-card">
                    <strong>{{label}}</strong>
                    <span>{{#str}}createdcount, local_personalgoals{{/str}}: {{created}}</span>
                    <span>{{#str}}completedcount, local_personalgoals{{/str}}: {{completed}}</span>
                    <span>{{#str}}expiredcount, local_personalgoals{{/str}}: {{expired}}</span>
                </div>
            {{/months}}
        </div>
    </section>
    {{/hasmonths}}

    <section class="personalgoals-section">
        <h3>{{#str}}allgoals, local_personalgoals{{/str}}</h3>
        {{^hasgoals}}<div class="personalgoals-empty">{{#str}}nogoalhistory, local_personalgoals{{/str}}</div>{{/hasgoals}}
        <div class="personalgoals-history-list">
            {{#goals}}
                <article class="personalgoals-history-item">
                    <div class="personalgoals-history-main">
                        <div class="personalgoals-course">{{coursename}}</div>
                        <h4>{{name}}</h4>
                        {{#isexpired}}<p class="personalgoals-neutral-message">{{expiredmessage}}</p>{{/isexpired}}
                        {{^isexpired}}<p class="text-muted mb-0">{{current}} / {{target}}</p>{{/isexpired}}
                    </div>
                    <div class="personalgoals-history-side">
                        <span class="personalgoals-status personalgoals-status-{{status}}">{{statuslabel}}</span>
                        <div class="progress personalgoals-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{progress}}">
                            <div class="progress-bar" style="width: {{progress}}%"></div>
                        </div>
                        {{^isactive}}<a class="btn btn-sm btn-outline-secondary" href="{{{repeaturl}}}">{{#str}}createagain, local_personalgoals{{/str}}</a>{{/isactive}}
                    </div>
                </article>
            {{/goals}}
        </div>
    </section>
</div>
