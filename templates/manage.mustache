{{!
    @template local_personalgoals/manage

    Example context (json):
    {
        *Example context (json):*
    }
}}
<div class="local-personalgoals personalgoals-manage">
    <div class="personalgoals-toolbar">
        <div>
            <h2>{{#str}}managegoals, local_personalgoals{{/str}}</h2>
            <p class="text-muted mb-0">{{#str}}manageintro, local_personalgoals{{/str}}</p>
        </div>
        <div class="personalgoals-actions">
            <a class="btn btn-primary" href="{{{newtemplateurl}}}">{{#str}}newtemplate, local_personalgoals{{/str}}</a>
            <a class="btn btn-secondary" href="{{{backurl}}}">{{#str}}backtogoals, local_personalgoals{{/str}}</a>
        </div>
    </div>

    <section class="personalgoals-section">
        <h3>{{#str}}suggestedtemplates, local_personalgoals{{/str}}</h3>
        {{^hastemplates}}<p class="text-muted">{{#str}}notemplates, local_personalgoals{{/str}}</p>{{/hastemplates}}
        {{#hastemplates}}
        <div class="table-responsive">
            <table class="table">
                <thead><tr><th>{{#str}}name{{/str}}</th><th>{{#str}}goaltype, local_personalgoals{{/str}}</th><th>{{#str}}active{{/str}}</th><th></th></tr></thead>
                <tbody>
                    {{#templates}}<tr><td>{{name}}</td><td>{{goaltype}}</td><td>{{activelabel}}</td><td class="text-right"><a href="{{{editurl}}}">{{#str}}edit{{/str}}</a></td></tr>{{/templates}}
                </tbody>
            </table>
        </div>
        {{/hastemplates}}
    </section>

    {{#haslimits}}
    <section class="personalgoals-section">
        <h3>{{#str}}studentlimits, local_personalgoals{{/str}}</h3>
        <p class="text-muted">{{#str}}studentlimitsdesc, local_personalgoals{{/str}}</p>
        <div class="table-responsive">
            <table class="table">
                <thead><tr><th>{{#str}}goaltype, local_personalgoals{{/str}}</th><th>{{#str}}enabled{{/str}}</th><th>{{#str}}allowedrange, local_personalgoals{{/str}}</th><th>{{#str}}maxactive, local_personalgoals{{/str}}</th><th></th></tr></thead>
                <tbody>
                    {{#limits}}<tr><td>{{name}}</td><td>{{enabledlabel}}</td><td>{{range}}</td><td>{{maxactive}}</td><td class="text-right"><a href="{{{editurl}}}">{{#str}}edit{{/str}}</a></td></tr>{{/limits}}
                </tbody>
            </table>
        </div>
    </section>
    {{/haslimits}}
</div>
